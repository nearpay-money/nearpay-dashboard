{
  "name": "nearpay-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "NearPay merchant dashboard: static SPA served at dashboard.<domain>, talking to the public API same-origin under /api.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.11.0 <23"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build": "vite build",
    "dev": "vite",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "verify": "pnpm typecheck && pnpm lint && pnpm coverage && pnpm build && pnpm e2e"
  },
  "dependencies": {
    "@hot-labs/near-connect": "0.11.4",
    "@nearpay/spec": "0.1.4",
    "@simplewebauthn/browser": "14.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "2.1.9",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  },
  "pnpm": {
    "overrides": {
      "@nearpay/spec": "0.1.4"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
